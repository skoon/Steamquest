[resource]
script = ExtResource("1_campaign")
levels = Array[ExtResource("2_level")]([SubResource("Level_yard"), SubResource("Level_tram"), SubResource("Level_row"), SubResource("Level_cisterns"), SubResource("Level_gardens"), SubResource("Level_seam"), SubResource("Level_foundry")])
