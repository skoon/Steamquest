[sub_resource type="Resource" id="Rumor_cistern_flood_log"]
script = ExtResource("4_rumor")
rumor_id = &"cistern_flood_log"
title = "Cistern Keeper's Flood Log"
body = "The tanks breathe twice a minute, near enough. Low water, high water, low water again, regular as the Foundry clock.\n\nAt high water the tanks are up to a man's knees. Wading is slow and murder on your boots and your gears. The arc-coils the Board installed in the tanks short out every time the water comes up over their feet; I have stopped reporting it.\n\nAnd the Warden is still down there. The diving rig the Master built to clear the outflow. It does not like visitors."
hint = "Deep water slows you and wears your drive gear. Cross the tanks at low water, or fight turrets while they are drowned."

[sub_resource type="Resource" id="Rumor_pump_order"]
script = ExtResource("4_rumor")
rumor_id = &"pump_order"
title = "Pump Hall Start-Up Card"
body = "A brass card riveted beside the pumps.\n\nSTART-UP ORDER, TO BE FOLLOWED EXACTLY:\n  First: pump II\n  Second: pump III\n  Third: pump I\n\nA valve opened out of turn reverses the whole system and floods the hall. Do not ask how we know."
hint = "Turn the pump valves II, then III, then I. A wrong valve floods the hall."

[sub_resource type="Resource" id="Rumor_sealed_project"]
script = ExtResource("4_rumor")
rumor_id = &"sealed_project"
title = "Work Order 1147"
body = "FROM THE OFFICE OF THE MASTER. PRIORITY.\n\nAll outflow capacity to be diverted to the deep works for the duration of the sealed project. The cistern crew is to be reassigned to the Foundry floor, night shift.\n\nNo questions regarding the nature of the project will be answered.\n\n- H."
hint = ""

