[sub_resource type="Resource" id="Rumor_canteen_menu"]
script = ExtResource("4_rumor")
rumor_id = &"canteen_menu"
title = "Canteen Menu, Night Shift"
body = "HARGREAVES WORKS CANTEEN. TONIGHT:\n  Leek and barley broth\n  Hothouse tomatoes on toast\n  Steamed treacle pudding\n\nChalked underneath, in a different hand: shift cancelled, all hands to the Foundry floor by order of the Master. Kitchen to stay open.\n\nThe pudding is still on the stove."
hint = "The steam in here is thick. Standing in the mist wears every gear in your rig twice as fast."

[sub_resource type="Resource" id="Rumor_gardener_note"]
script = ExtResource("4_rumor")
rumor_id = &"gardener_note"
title = "Gardener's Note"
body = "They still tend the rows. Every night, regular as the tide, the little automatons come up out of those scrap heaps and water the beds and pick the fruit and carry it to the canteen, and nobody eats it.\n\nThe heaps are nests. Something in them keeps building more. Smash the glowing core in each one and they stop.\n\nI am going down to find the night shift."
hint = "Smash all three nests. The lift door answers only when every nest is dead."

