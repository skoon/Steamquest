[sub_resource type="Resource" id="Rumor_tramline_suspended"]
script = ExtResource("4_rumor")
rumor_id = &"tramline_suspended"
title = "Line Notice: Service Suspended"
body = "POSTED BY ORDER OF THE TRAMWAYS BOARD.\n\nThe freight lift to the Foundry gates is locked out while line pressure is down. Both pressure valves must be opened, the concourse valve and the signal-hall valve, before the lift will answer.\n\nThe trams themselves still run on the old timetable. Nobody knows who is driving them."
hint = "Bash the concourse valve and the signal-hall valve. Both must be open before the Freight Lift door unseals."

[sub_resource type="Resource" id="Rumor_signalman_log"]
script = ExtResource("4_rumor")
rumor_id = &"signalman_log"
title = "Signalman's Log"
body = "Night 1: The lamps rang and the 11:40 came through empty. No driver. Brakes never touched.\n\nNight 9: Something with too many legs was riding the roof of the 2:15. It looked at me.\n\nNight 30: The dogs came up out of the tunnel tonight. Clockwork, and hungry for it, and they hunt together. Never let them get round behind you. When the bell rings, get off the rails. The trams do not stop for them either."
hint = "When the signal lamps flash and the bell rings, clear the rails. Trams hit automatons too."

