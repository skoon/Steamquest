[sub_resource type="Resource" id="Rumor_lamp_room_card"]
script = ExtResource("4_rumor")
rumor_id = &"lamp_room_card"
title = "Lamp Room Rules"
body = "EVERY MINER TAKES A LAMP. EVERY LAMP COMES BACK.\n\nThe seam is black as the inside of a boiler. Light the wall lanterns as you go; a lit lantern stays lit, and it will see you home.\n\nThe ore carts run downhill on their own when the brakes slip. If you hear the rails start to sing, get off them."
hint = "Press F at a wall lantern (or hit it with the wrench) to light it. Ore carts hit hard. Clear the rails when they rumble."

[sub_resource type="Resource" id="Rumor_shift_roster"]
script = ExtResource("4_rumor")
rumor_id = &"shift_roster"
title = "Shift Roster, Seam Four"
body = "A slate board, chalk names in two neat columns.\n\nEvery name has been struck through. All of them in the same hand, all on the same night. At the bottom, in that same hand:\n\nREASSIGNED. FOUNDRY FLOOR. GUARD DUTY.\n\nThe automatons were never the ones on guard duty, were they."
hint = ""

[sub_resource type="Resource" id="Rumor_winchman_warning"]
script = ExtResource("4_rumor")
rumor_id = &"winchman_warning"
title = "Winchman's Warning"
body = "The winch brake is seized. Knock it free, engage the drum, and do NOT walk away from it. It only winds while someone minds it.\n\nThey will come for the noise. They always come for the noise. Whatever the Master is keeping down there, he wants it kept, and the machines have heard him."
hint = "Bash the winch brake free, press F to engage it, then stay close while it winds. Waves will come."

