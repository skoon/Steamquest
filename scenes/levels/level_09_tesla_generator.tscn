[sub_resource type="Resource" id="Rumor_plate_warning"]
script = ExtResource("4_rumor")
rumor_id = &"plate_warning"
title = "Hall Foreman's Warning"
body = "The floor plates in this hall carry the overflow. They take it in turns, row by row: a blue flicker, then the full current, then dark again.\n\nWatch the flicker. Step where it has just gone dark, not where it is about to light."
hint = "Plates flicker before they go live. Cross behind the sweep."

[sub_resource type="Resource" id="Rumor_coil_overload_memo"]
script = ExtResource("4_rumor")
rumor_id = &"coil_overload_memo"
title = "Memo: Coil Discipline"
body = "Staff are reminded NOT to strike the main coils. A struck coil dumps its whole charge at once, and every drone within a stone's throw drops out of the air like a dead pigeon.\n\nIt takes the coil a good twelve seconds to recharge. The drones do not take kindly to it."
hint = "Shoot a glowing Tesla coil to overload it. Drones nearby fall out of the air for a few seconds, and nearby turrets get scorched."

[sub_resource type="Resource" id="Rumor_earth_bank_card"]
script = ExtResource("4_rumor")
rumor_id = &"earth_bank_card"
title = "Earth Bank Routing Card"
body = "To send the surplus to the earth bank and kill the plates by the lift:\n\n  Junction A: III\n  Junction B: I\n  Junction C: II\n\nAny other setting dumps the current into one of the floor sections. You will know which."
hint = "Set junction A to III, B to I and C to II to earth the current and open the generator lift."

[sub_resource type="Resource" id="Rumor_deep_works_log"]
script = ExtResource("4_rumor")
rumor_id = &"deep_works_log"
title = "Generator Log, Final Entry"
body = "Load doubled tonight. The Master has the deep works drawing every amp we make, and the machines down there have stopped asking permission for anything.\n\nThe night shift went down at midnight on his order. The lift came back up empty."
hint = ""

