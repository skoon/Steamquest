[sub_resource type="Resource" id="Rumor_overseer_yard_log"]
script = ExtResource("4_rumor")
rumor_id = &"overseer_yard_log"
title = "The Overseer's Commission Plate"
body = "Riveted to the Walker's cradle: COMMISSIONED BY THE MASTER, OVERSEER OF THE ENGINE YARD.\n\nScratched beneath it by the yard crew: The Walker is the last line. The Master had it built to stand in front of the Foundry Gate and let nothing past, and it has stood there eleven years, cold, waiting.\n\nIt stamps when you are close. When its boiler is hot it breathes steam across the whole yard, then has to stand and blow off. That is when its boiler valve shows. Hit the valve and it will reel.\n\nIf it is losing, it whistles up the yard automatons and runs at you. Watch for the red lane."
hint = "The Steam Walker stomps, then breathes steam and overheats: bash its exposed boiler valve 3 times to stagger it, then pile on the damage. When hurt, it summons automatons and charges down a red lane."

[sub_resource type="Resource" id="Rumor_foundry_seal_note"]
script = ExtResource("4_rumor")
rumor_id = &"foundry_seal_note"
title = "Brass Plate on the Foundry Gate"
body = "THE GREAT FOUNDRY.\nBY ORDER OF THE MASTER THIS GATE ANSWERS ONLY TO THE FOUNDRY SEAL.\n\nThe seal is carried by the Yard's guardian."
hint = "Defeat the Steam Walker and pick up the Foundry Seal to open the Foundry Gate."

[sub_resource type="Resource" id="Rumor_guild_dispatch_12"]
script = ExtResource("4_rumor")
rumor_id = &"guild_dispatch_12"
title = "Dispatch #12: The Last Gate"
body = "Pneumatic dispatch, Guild of Mechanical Trades. The last tube that reaches this deep.\n\nTechnician, your signal is faint but steady. Past this yard lies the Great Foundry. The old Overseer's machine still holds the gate, and the gate answers only to the Foundry Seal it carries.\n\nWe cannot send help this far down. Bring the Walker down, take the seal, and go in. The families are still waiting."
hint = ""

