[sub_resource type="Resource" id="Rumor_dispatch_briefing"]
script = ExtResource("4_rumor")
rumor_id = &"dispatch_briefing"
title = "Dispatch #1: The Job"
body = "Pneumatic dispatch, Guild of Mechanical Trades.\n\nEleven years ago the Hargreaves Automaton & Clockwork Foundry fell silent in a single night. The automatons kept working. The workers did not come home.\n\nThe Guild sends you, Technician, with a pipe-wrench, a rivet gun and a diagnostic rig full of tired scavenged gears. Every cog you carry grinds a little more with each step. Ride the old tramline down to the Foundry and find what Master Hargreaves hid in its core. They say whoever carries it will never grind again."
hint = "Controls: WASD move, Space steam-dash, LMB wrench, RMB rivet gun (costs pressure), R lubricant vent, F interact, Q/E rotate camera, Tab log, G gear sockets."

[sub_resource type="Resource" id="Rumor_yard_valve_memo"]
script = ExtResource("4_rumor")
rumor_id = &"yard_valve_memo"
title = "Yard Memo: The Gate"
body = "To whoever has the yard tonight:\n\nThe office gate runs on yard pressure, and the release valve by the gate has seized solid again. Do not waste good oil on it. Three honest blows with a wrench will shake it loose, as they always have.\n\nAnd mind the scrap-spiders. They have been crawling up out of the old Foundry drains for weeks.\n\n- Yardmaster Pell"
hint = "Bash the seized valve beside the east gate with your wrench (3 hits)."

[sub_resource type="Resource" id="Rumor_guild_primer"]
script = ExtResource("4_rumor")
rumor_id = &"guild_primer"
title = "Guild Primer: Pressure and Friction"
body = "Page 3 of the apprentice primer, dog-eared.\n\nYour rivet gun and your steam-dash both draw on the rig's pressure. Spend it, and the pump will refill it in time.\n\nEvery gear in your rig gathers friction as it works. A hot gear is a slow gear, and a slow gear wears its teeth away. When the grinding gets loud, open the lubricant vent: it purges the friction and overclocks the rig for a few heartbeats.\n\nA cracked gear can be swapped for any scrap gear you find lying about."
hint = "R vents lubricant (friction purged, short overclock). Press G to see the state of each gear socket."

[sub_resource type="Resource" id="Rumor_missing_notice"]
script = ExtResource("4_rumor")
rumor_id = &"missing_notice"
title = "Notice: Missing Persons"
body = "PASTED TO THE DISPATCH WINDOW, MANY TIMES OVER.\n\nHAVE YOU SEEN THEM? 312 hands of the Hargreaves Foundry, night shift, not returned these eleven years. Smelters, gear-cutters, boiler stewards, a foreman named Aldous Brack.\n\nAny word to the Guild office. The families still wait."
hint = ""

[sub_resource type="Resource" id="Rumor_tram_notice"]
script = ExtResource("4_rumor")
rumor_id = &"tram_notice"
title = "Tramline Notice"
body = "The Foundry line is CLOSED until further notice. The line was never formally closed; the trams simply stopped coming back.\n\nThe service lift at the end of this platform still drops to the tram tunnel. Use at your own risk."
hint = "Step onto the lift platform to descend to the Pneumatic Tramline."

