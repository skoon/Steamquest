[sub_resource type="Resource" id="Rumor_harbourmaster_log"]
script = ExtResource("4_rumor")
rumor_id = &"harbourmaster_log"
title = "Harbourmaster's Log"
body = "The tower takes the weather full in the face. Gusts come in off the estuary every few breaths. The sock on the mast goes taut just before; when it does, get your weight low and stay clear of the gaps in the rail. We lost two crates and a junior clerk that way.\n\nAnd mind the engine test stands. A propeller will take your arm off, but stand in its wash and no gust on earth will shift you."
hint = "When the windsock snaps taut a gust is coming. Gusts push everyone, automatons too: knock them off the edge with the wrench."

[sub_resource type="Resource" id="Rumor_crate_manifest"]
script = ExtResource("4_rumor")
rumor_id = &"crate_manifest"
title = "Crate Manifest, Skylark Inbound"
body = "SKYLARK, inbound from the Guild City. The last airship to tie up here.\n\n  12 crates: precision bearings, finest grade\n  4 crates: lubricant, whale and mineral\n  1 crate: sealed, not to be opened by stevedores\n\nCONSIGNEE: the Master, deep works. Deliver by hand.\n\nShe was meant to leave again at midnight with the night shift aboard. She never cast off."
hint = ""

[sub_resource type="Resource" id="Rumor_drone_bulletin"]
script = ExtResource("4_rumor")
rumor_id = &"drone_bulletin"
title = "Works Bulletin: Coil Drones"
body = "The new coil drones patrol the gantries now. They hover well out of reach, circle you and spit arcs. A rivet brings them down quickest.\n\nThe gangway has two release levers, one at each end of the gantry, so no fool drops it by accident. Pull both and it lowers to the Foundry's outer wall."
hint = "Tesla drones keep their distance. Shoot them with the rivet gun. Pull both gangway levers, one at each end of the Mooring Gantry."

