[sub_resource type="Resource" id="Rumor_archive_rules"]
script = ExtResource("4_rumor")
rumor_id = &"archive_rules"
title = "Rules of the Reading Room"
body = "SILENCE IN THE ARCHIVE.\n\nThe night porters walk their rounds with their lanterns lit. If a porter's lantern falls on you, the bells ring and the coil-guards wake. Keep to the shadows behind them, or keep a stout wrench handy.\n\nThe guards go back to sleep once the bells have been quiet a while."
hint = "Patrolling sentries only see what their lantern cone lights. Getting spotted rings the alarm and wakes the turrets; they sleep again after 20 quiet seconds."

[sub_resource type="Resource" id="Rumor_access_code_note"]
script = ExtResource("4_rumor")
rumor_id = &"access_code_note"
title = "Note Pinned to the Stacks"
body = "The deep-works access code is drawn on three blueprint sheets, filed in three different places so no single clerk can read it.\n\nOne in the west stacks, one in the east stacks, one on the Master's own drafting table.\n\nThe archive lift will not run without all three."
hint = "Collect the three blueprint pages. The archive lift opens when you hold all of them."

[sub_resource type="Resource" id="Rumor_the_last_order"]
script = ExtResource("4_rumor")
rumor_id = &"the_last_order"
title = "Dictation Cylinder, Master's Office"
body = "A wax cylinder on a phonograph, the needle still resting in the groove. You wind it and it plays.\n\n\"To every automaton of the Hargreaves Works. This is your Master speaking. From this hour you have one task above all others. Guard the Gear. Let no one near it. No one. Not the Guild, not the Board, not the night shift, not me if I should come back and ask for it.\n\nGuard the Gear.\"\n\nThe recording ends in a long hiss."
hint = ""

