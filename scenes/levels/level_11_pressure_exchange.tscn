[sub_resource type="Resource" id="Rumor_exchange_duty_card"]
script = ExtResource("4_rumor")
rumor_id = &"exchange_duty_card"
title = "Duty Card: Exchange Steward"
body = "The exchange takes the whole Foundry's back-pressure. The great gauge climbs on its own, all shift, every shift.\n\nKeep it out of the red. A blow on any relief valve vents a good share of it, then the valve wants a few breaths to reseal. Let the gauge peak and the strained runs - the ones painted in hazard orange - burst wide open. Stay off the orange when the klaxon sounds."
hint = "Room pressure climbs constantly (HUD). Bash relief valves to vent it. Above the red line the orange-marked pipe runs steam; at full pressure they burst."

[sub_resource type="Resource" id="Rumor_steward_last_entry"]
script = ExtResource("4_rumor")
rumor_id = &"steward_last_entry"
title = "Pressure Clerk's Last Entries"
body = "Eleven o'clock. An order came down the tube in the Master's own hand: divert everything to the Gear vault. Every valve, every main, all of it, and let the rest of the works go short.\n\nMidnight. The night shift came through on the Master's order, all three hundred of them, single file, down to the deep foundry. Brack at the front, not looking at anyone.\n\nThe automatons stood aside to let them pass. They have never stood aside for anyone before.\n\nThe gauge is climbing faster tonight. Something below is drawing hard."
hint = ""

[sub_resource type="Resource" id="Rumor_main_stack_notice"]
script = ExtResource("4_rumor")
rumor_id = &"main_stack_notice"
title = "Notice: Main Relief Stack"
body = "The lift to the Overseer's yard is held by the main relief stack at the end of the manifold hall. It seized the night the shift went down and nobody has had the nerve to touch it since.\n\nThree good blows should free it. Watch the gauge while you work."
hint = "Free the Main Relief Stack valve in the Manifold Hall (3 hits) to open the Exchange Lift."

