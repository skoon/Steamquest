[sub_resource type="Resource" id="Rumor_perpetual_engine_advert"]
script = ExtResource("4_rumor")
rumor_id = &"perpetual_engine_advert"
title = "Advertisement: The Perpetual Engine"
body = "A gilt-framed handbill, faded to the colour of tea.\n\nHARGREAVES & SONS proudly announce THE PERPETUAL ENGINE! Motion without friction! Labour without wear! A single golden gear at its heart, cut by the Master's own hand, ensures your engine shall never tire, never grind, never fail.\n\nInquire within. Demonstrations daily. Beware imitations."
hint = "Brass Sentries block wrench and rivet from the front. A rivet on the shield knocks it aside for a moment; the glowing boiler marks their back."

[sub_resource type="Resource" id="Rumor_curator_note"]
script = ExtResource("4_rumor")
rumor_id = &"curator_note"
title = "Curator's Note"
body = "Gallery attendants are reminded that the sentries are decorative. They are NOT to be wound after hours.\n\nThe Master insists every sentry keeps its shield to the visitor at all times. It turns slowly, being heavy, and an attendant who stepped around one in the old days could polish its back without it ever noticing. Kindly do not test this on duty. Nor are the rivet guns to be fired at the shields: a rivet knocks the shield aside, and the sentry takes it very personally."
hint = "Sentries turn slowly. Rivet the shield to stagger one, or dash past and strike the boiler on its back."

[sub_resource type="Resource" id="Rumor_apprentice_diary"]
script = ExtResource("4_rumor")
rumor_id = &"apprentice_diary"
title = "Apprentice's Diary"
body = "The Master came through the showroom tonight, which he never does. He wound every sentry himself and told them something I could not hear. Then he locked the service lift with the great winding key and left the key on the bench in the back, under the sentries' eyes.\n\nHe said the lift goes down to the Foundry gates, and that no one should follow him."
hint = "The winding key lies in the Workshop Backroom. Carry it to the clockwork door of the Service Lift."

