[sub_resource type="Resource" id="Rumor_arrival"]
script = ExtResource("4_rumor")
rumor_id = &"arrival_log"
title = "Dispatch #13: The Great Foundry"
body = "Pneumatic dispatch, recovered from the intake tube.\n\nYou made it, Technician. The yard, the tramline, the showroom, the cisterns, the gardens, the coal seam, the mooring tower, the archive, the generator hall, the assembly line, the pressure exchange and the Overseer's yard: all behind you. The Foundry Seal opened the gate, and the Walker that carried it will not get up again. This is the Great Foundry itself, where the night shift vanished eleven years ago and the automatons never stopped working.\n\nEvery guard the Master left is in here with you now: hounds, sentries, coil drones and worse. Whatever he hid is somewhere past the boiler rooms, the cutting floor and the smelting vats. The Guild is listening for your signal. Find the gear that never grinds, and bring it home."
hint = "The way deeper lies east, through the Boiler Room bulkhead."

[sub_resource type="Resource" id="Rumor_valve"]
script = ExtResource("4_rumor")
rumor_id = &"valve_memo"
title = "Memo: Bulkhead B-1"
body = "To the night shift:\n\nThe east bulkhead is held shut by back-pressure from the main line. The release valve beside it has seized solid again. The manual says lubricate. The manual is wrong. Three honest blows with a wrench will shake it loose, as they always have.\n\n- E. Pell, Boiler Steward"
hint = "Bash the seized valve near the east bulkhead with your wrench (3 hits)."

[sub_resource type="Resource" id="Rumor_override"]
script = ExtResource("4_rumor")
rumor_id = &"cutting_floor_override"
title = "Foreman's Override Card"
body = "Punched brass card, stamped SMELTING ACCESS.\n\nThe Smelting bulkhead obeys no valve. It answers only to the foreman's override sequence: seven, one, one, four, then a half-turn of the governor. Do not lose this card. Do not let the skitterers nest in the governor housing again."
hint = "You know the override now. Use the lock panel on the east bulkhead of the Gear Cutting Floor."

[sub_resource type="Resource" id="Rumor_golden"]
script = ExtResource("4_rumor")
rumor_id = &"golden_rumor"
title = "Workshop Rumor: The Frictionless Cog"
body = "Scrawled on the back of a tooth-gauge chart:\n\nThey say Hargreaves cut one gear by hand over seven winters. Gold, they say, but no gold ever behaved like it. It turns without heat. Its teeth never wear. Seat it in any engine and the whole train runs true.\n\nThey say he kept it past the Smelting Vats, where the Bruisers stand guard, and that the vault below would not open without it."
hint = "The Golden Gear rests on a pedestal at the far end of the Smelting Vats."

[sub_resource type="Resource" id="Rumor_foreman"]
script = ExtResource("4_rumor")
rumor_id = &"foreman_log"
title = "Foreman's Log: The Vault Elevator"
body = "Day 4012. The Master Clock Vault elevator is driven by a single master cog. Hargreaves keyed the vault bulkhead to its resonance, so only the Golden Gear can unseal it. When the automatons turned, he set the Gear upon the pedestal and told us to run.\n\nWe ran. The arc turrets still sing at night."
hint = "Recovering the Golden Gear unseals the vault bulkhead and wakes the elevator."

[sub_resource type="Resource" id="Rumor_vault"]
script = ExtResource("4_rumor")
rumor_id = &"vault_inscription"
title = "Etched Blueprint: The Master Clock"
body = "An etching on brass plate, signed A. Hargreaves:\n\nEvery engine fails in time. Friction is the debt we pay for motion, and wear is how the debt is collected. I have spent my life looking for a gear that owes nothing.\n\nWhoever carries it now: ride the elevator up, and let the foundry rest."
hint = "Step onto the elevator platform to leave the foundry."

